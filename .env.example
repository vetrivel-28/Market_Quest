# ==============================================================================
# MarketQuest Environment Variables Template
# ==============================================================================
# Copy this file to .env and supply your credentials.
# Do NOT commit your actual .env file to version control.
# ==============================================================================

# Primary AI Model API Key (Used by FastAPI REST API in api/main.py & render.yaml)
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis Cache Layer (Used by api/cache.py for low-latency caching)
# Connection protocol: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:your_upstash_redis_token@workable-stinkbug-203888.upstash.io:6379
REDIS_TOKEN=your_upstash_redis_token_here
REDIS_ENABLED=true
CACHE_DEFAULT_TTL=900

# Optional: Scraper & Community Analytics Credentials (Used by config.py)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=your_reddit_user_agent_here
YOUTUBE_API_KEY=your_youtube_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
